<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play-distributed builds must use Play's own update path. MyFinHub's direct
         PackageInstaller updater is intentionally unavailable in this variant. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />

    <!-- Private SMS capture is not declared for Play without policy approval. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <application>
        <receiver android:name=".feature.bankalert.BankSmsReceiver" tools:node="remove" />
    </application>
</manifest>
